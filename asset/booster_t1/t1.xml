          <geom name="cam_fov_near_left"   type="capsule" size="0.005" fromto="0.130 -0.05 0.088 0.130 -0.05 0.152" rgba="1.0 0.55 0.10 0.95" contype="0" conaffinity="0" mass="0" group="4"/>
          <!-- Far rect: y=±0.6, z=-0.263..0.503 (1.20 m wide) -->
          <geom name="cam_fov_far_top"     type="capsule" size="0.005" fromto="0.680 -0.6 0.503 0.680  0.6 0.503" rgba="1.0 0.55 0.10 0.95" contype="0" conaffinity="0" mass="0" group="4"/>
          <geom name="cam_fov_far_right"   type="capsule" size="0.005" fromto="0.680  0.6 0.503 0.680  0.6 -0.263" rgba="1.0 0.55 0.10 0.95" contype="0" conaffinity="0" mass="0" group="4"/>
          <geom name="cam_fov_far_bot"     type="capsule" size="0.005" fromto="0.680  0.6 -0.263 0.680 -0.6 -0.263" rgba="1.0 0.55 0.10 0.95" contype="0" conaffinity="0" mass="0" group="4"/>
