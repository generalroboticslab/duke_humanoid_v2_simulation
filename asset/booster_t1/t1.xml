          <!-- D455 RGB head camera: 90° h × 65° v FOV (T1 RealSense version).
               Mount flush on H2 head-sphere front surface (sphere center (0.01,0,0.11),
               radius 0.08 -> front surface x=0.09, 10mm recessed) as the camera lens.
               Source-of-truth: Booster T1 Instruction Manual V1.0 + Intel D455 datasheet.
               T1 D455 sits at the front of the head looking FORWARD (+X in base_link),
               landscape-mounted (90° wide horizontal, 65° narrow vertical in world; no
               roll about the optical axis). MuJoCo cameras look along local -Z, so
               quat = -π/2 about Y maps camera forward (-Z) onto world +X. Site shares
               the same quat, kept colinear with the camera for raycast origin/FOV checks. -->
          <camera name="head_cam" pos="0.080 0 0.12" quat="0.7071 0 -0.7071 0" fovy="65" resolution="1280 800" />
          <site name="head_cam_site" pos="0.080 0 0.12" quat="0.7071 0 -0.7071 0" size="0.005" rgba="0 0 1 0.5" />
